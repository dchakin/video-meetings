generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  passwordHash  String
  name          String?
  avatarUrl     String?
  // Увеличивается при смене пароля — делает недействительными все ранее выданные JWT.
  tokenVersion  Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  meetings      Meeting[]
  uploadedFiles MeetingFile[]
}

model Meeting {
  id           String          @id @default(uuid())
  title        String
  date         DateTime
  participants String[]
  ownerId      String
  owner        User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  files        MeetingFile[]
  summary      MeetingSummary?

  @@index([ownerId])
}

model MeetingFile {
  id           String   @id @default(uuid())
  meetingId    String
  meeting      Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  fileName     String
  mimeType     String
  size         Int
  storagePath  String
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  // `null` — транскрибация неприменима (файл не video/mp4 или audio/mpeg); заполняется
  // сразу при создании записи для mp4/mp3, дальше проходит QUEUED → IN_PROGRESS → DONE|ERROR.
  transcriptionStatus TranscriptionStatus?
  transcriptionText   String?

  @@index([meetingId])
}

// Одна выжимка на встречу; повторная генерация целиком заменяет содержимое.
model MeetingSummary {
  id          String               @id @default(uuid())
  meetingId   String               @unique
  meeting     Meeting              @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  status      MeetingSummaryStatus
  summary     String?
  // [{ description: string, assignee: string | null }]
  actionItems Json                 @default("[]")
  decisions   String[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

enum TranscriptionStatus {
  QUEUED
  IN_PROGRESS
  DONE
  ERROR
}

enum MeetingSummaryStatus {
  IN_PROGRESS
  DONE
  ERROR
}
